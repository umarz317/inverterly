# Copy to ~/.config/inverterly/.env and fill in. Keep it private: chmod 600.
# The same login you use in the WatchPower, SolarPower or DessMonitor phone app.
SHINEMONITOR_USER=
SHINEMONITOR_PASSWORD=

# Which cloud the phone app talks to: dessmonitor (https), watchpower or solarpower (plain http).
SHINEMONITOR_APP=dessmonitor

# Only needed when the account has more than one device: the Wi-Fi logger's PN and the inverter's serial.
# SHINEMONITOR_PN=
# SHINEMONITOR_SN=
